{
  "name": "class-quest",
  "version": "1.0.0",
  "description": "Class Quest desktop and Android application",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "android:prepare": "node scripts/prepare-android.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "electron": "34.3.0",
    "electron-builder": "26.0.12",
    "@capacitor/assets": "^3.0.5",
    "sharp": "^0.34.2"
  },
  "build": {
    "appId": "ru.classquest.desktop",
    "productName": "Class Quest",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "electron/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
